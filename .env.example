# Copie para .env somente se precisar sobrescrever os defaults.
AGRI_ENVIRONMENT=development
AGRI_LOG_LEVEL=INFO
AGRI_PROJECT_ROOT=.
AGRI_DATABASE_URL=postgresql+psycopg://agri:change-me@localhost:5432/agri

# Credencial CDS opcional. Prefira %USERPROFILE%\.cdsapirc, criado manualmente.
# Alternativamente, o cliente aceita CDSAPI_KEY e CDSAPI_RC. Nunca commite valores reais.
CDSAPI_KEY=
CDSAPI_RC=
